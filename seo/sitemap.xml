<?xml version="1.0" encoding="UTF-8"?>
<!--
  ConnectNaija sitemap template
  In production, generate dynamically to include only:
  - Static public pages
  - Approved public profile pages (with stable URLs)
  - Useful location/category landing pages that have real content
  
  Exclude: dashboard, favorites, login, register, drafts, paused/removed profiles,
  and arbitrary search-filter URL combinations.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://connectnaija.example/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://connectnaija.example/browse.html</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://connectnaija.example/list-profile.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://connectnaija.example/safety.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://connectnaija.example/privacy.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>
  <url>
    <loc>https://connectnaija.example/terms.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>
  <url>
    <loc>https://connectnaija.example/age-policy.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://connectnaija.example/contact.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <!-- 
    Production: add location pages e.g.
    /browse/lagos/ , /browse/abuja/ , /browse/lagos/lekki/
    and approved profile pages e.g. /profile/adaeze-001/
    with lastmod dates from the CMS/database.
  -->
</urlset>
